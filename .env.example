# Long-running Node.js / WebSocket server configuration
PORT=3000
NODE_ENV=production
# Set a persistent writable data volume for durable guest rankings.
DATA_FILE=./data/players.json
# Comma-separated list of browser frontend origins if hosted separately.
# Example: https://gsmktm.github.io,https://baghchal.example.com
ALLOWED_ORIGINS=https://gsmktm.github.io
